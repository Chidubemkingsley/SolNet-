# Copy to .env to override the built-in defaults (standalone + localhost).
# Every value below is optional; unset entries fall back automatically.
VITE_STELLAR_NETWORK=standalone
VITE_STELLAR_RPC_URL=http://localhost:8000/soroban/rpc

# Deployed contract IDs. Unset entries fall back to the IDs written by
# deploy.sh into src/lib/deployed-contracts.ts.
# VITE_CONTRACT_GRID_TOPOLOGY=
# VITE_CONTRACT_ACCOUNT_LEDGER=
# VITE_CONTRACT_MICRO_BILLING=
# VITE_CONTRACT_DELINQUENCY_DISCONNECTOR=
# VITE_CONTRACT_YIELD_AUCTION=
# VITE_CONTRACT_PEAK_LOAD_ADJUSTER=
# VITE_CONTRACT_BATTERY_POOL=
# VITE_CONTRACT_COMMUNITY_CAPITAL=
# VITE_CONTRACT_IOT_REGISTRAR=
# VITE_CONTRACT_CRYPTOGRAPHIC_ORACLE=
# VITE_CONTRACT_FIRMWARE_VERIFIER=
# VITE_CONTRACT_HARDWARE_SLASH=
